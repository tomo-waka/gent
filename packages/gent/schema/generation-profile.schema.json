{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tomo-waka/gent/main/packages/gent/schema/generation-profile.schema.json",
  "title": "GenT Generation Profile",
  "type": "object",
  "properties": {
    "debug": {
      "title": "Debug flag",
      "description": "for dev.",
      "type": "boolean",
      "default": false
    },
    "from": {
      "title": "From date time",
      "type": "string",
      "format": "date-time"
    },
    "to": {
      "title": "To date time",
      "type": "string",
      "format": "date-time"
    },
    "count": {
      "title": "Count of entries",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "out": {
      "title": "Generation output",
      "$ref": "#/$defs/outputOptions"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/templateOptions"
      }
    }
  },
  "required": ["out", "templates"],
  "additionalProperties": false,
  "$defs": {
    "templateMode": {
      "title": "Template mode",
      "type": "string",
      "enum": ["text", "json"]
    },
    "templateOptions": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/templateMode"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "title": "Weight for random selection",
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "outputOptions": {
      "oneOf": [
        {
          "title": "Simple File output",
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "./output/file-output.schema.json"
        },
        {
          "$ref": "./output/udp-output.schema.json"
        },
        {
          "$ref": "./output/tcp-output.schema.json"
        },
        {
          "$ref": "./output/tls-output.schema.json"
        }
      ]
    }
  }
}
