{
  "compilerOptions": {
    /* Modules */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    /* Language and Environment */
    "target": "es2024",
    /* Type Checking */
    "strict": true,
    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
